{
  "name": "@propertydek/pdk-assistant-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/pdk-assistant.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:spacing": "node scripts/check-spacing.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm run check:spacing && npm run check:contrast && npm test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
